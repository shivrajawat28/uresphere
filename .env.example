# ─────────────────────────────────────────────────────────────────────────────
# Uresphere — environment variables
# Copy to `.env.local` and fill in real values. Never commit .env* files.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase project URL (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/publishable key (safe for the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: override the auth redirect origin in local dev
# (useful when Supabase's "Site URL" is set to a tunnel URL)
# NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback

# Vercel Blob read/write token (used for marketplace image uploads)
# https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=your-vercel-blob-token

# Canonical site URL used for SEO metadata (optional, defaults to localhost)
# NEXT_PUBLIC_APP_URL=https://uresphere.com
